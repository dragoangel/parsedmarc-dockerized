# Zewnętrzna sieć docker, gdzie działa stack Elasticsearch/Kibana
ELASTIC_NETWORK=elasticsearch_elastic

# Opcjonalnie: msgraph-token-refresh (profile: msgraph-secret lub msgraph-cert)
TENANT_ID=
CLIENT_ID=
MSGRAPH_CERT_THUMBPRINT=
GRAPH_URL=https://graph.microsoft.com
REFRESH_SECONDS=3300

# docker-compose-elk.yml: Kibana encryption keys (required, 32+ random chars each).
# Generate with: openssl rand -hex 32
# Keep them stable: changing them makes existing encrypted saved objects unreadable.
KIBANA_ENCRYPTEDSAVEDOBJECTS_KEY=
KIBANA_REPORTING_KEY=
KIBANA_SECURITY_KEY=

# Host address the search cluster and Kibana/Dashboards ports are published on.
# Defaults to 127.0.0.1 because both run without authentication.
# ES_BIND_ADDRESS=127.0.0.1
# OPENSEARCH_BIND_ADDRESS=127.0.0.1
# KIBANA_BIND_ADDRESS=127.0.0.1

# parsedmarc secrets. Prefer these over editing passwords into the tracked
# parsedmarc/parsedmarc.ini; each one overrides the matching ini value when set.
# PARSEDMARC_IMAP_PASSWORD=
# PARSEDMARC_ELASTICSEARCH_PASSWORD=
# PARSEDMARC_ELASTICSEARCH_API_KEY=
# PARSEDMARC_OPENSEARCH_PASSWORD=
# PARSEDMARC_MSGRAPH_PASSWORD=
# PARSEDMARC_MSGRAPH_CLIENT_SECRET=
